# -----------------------------------------------------------------------------
# Copy to .env for local development:  cp .env.example .env
# On Vercel, set these in Project Settings -> Environment Variables.
# Never commit real secrets.
# -----------------------------------------------------------------------------

# --- Database (Postgres) ------------------------------------------------------
# Local: docker compose -f docker-compose.dev.yml up -d  (see README)
# Neon via Vercel Marketplace sets both of these automatically:
#   DATABASE_URL           pooled connection (host contains "-pooler"), used by the app
#   DATABASE_URL_UNPOOLED  direct connection, used for migrations
DATABASE_URL=postgres://msb_owner:msb_owner@localhost:5432/msb_dev
# DATABASE_URL_UNPOOLED=

# Integration tests use a separate database (created by the same compose file).
TEST_DATABASE_URL=postgres://msb_owner:msb_owner@localhost:5432/msb_test

# --- Auth ---------------------------------------------------------------------
# At least 32 random characters. Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters

# --- Routing ------------------------------------------------------------------
# subdomain: {store}.ROOT_DOMAIN, app.ROOT_DOMAIN, admin.ROOT_DOMAIN (needs your own domain)
# path:      ROOT_DOMAIN/store/{store}, ROOT_DOMAIN/admin  (use this on *.vercel.app)
ROUTING_MODE=subdomain
# Host (+ port in dev). Locally, *.localhost resolves to 127.0.0.1 in Chrome/Firefox.
# On Vercel in path mode you can leave it unset: VERCEL_PROJECT_PRODUCTION_URL is used.
ROOT_DOMAIN=localhost:3000
# Defaults: true in production, false otherwise.
# USE_HTTPS=false
# 301 store traffic to the store's primary custom domain. Default: true in production.
# ENFORCE_CANONICAL_HOST=false

# Display name until the brand is decided.
PLATFORM_NAME=StoreBuilder

# --- Seeding (pnpm db:seed) ---------------------------------------------------
# Creates/promotes this user to super admin. Password: 12+ characters.
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=change-me-please-123
# Password for the demo owner created by `pnpm db:seed:demo` (dev only).
# SEED_DEMO_PASSWORD=demo-password-123

# --- Image storage ------------------------------------------------------------
# local: files in ./.data/uploads served by the app (dev, or a server with a persistent disk).
#        Refused on Vercel, whose filesystem is wiped between requests.
# s3:    any S3-compatible bucket. Cloudflare R2 recommended (free egress).
STORAGE_DRIVER=local
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=hainez-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public URL of the bucket (custom domain or the bucket's r2.dev URL), no trailing slash
# S3_PUBLIC_URL=https://cdn.example.com
# UPLOAD_MAX_BYTES=5242880
